-- Easy Rule to Remember
/*
Text → 'quotes'
Number → no quotes
Date → 'quotes'
NULL → NULL without quotes
*/

-- NULL Value

/*
NULL means a value is missing, unknown, or not available in a database.
NULL is not a value itself.
NULL is not 0.
NULL is not an empty string ''.

A column can contain NULL when no value was provided.
*/

select *
FROM Customers_db
WHERE ContactName IS NULL;

-- UPDATE Statement
-- the UPDATE is used to update  or modify one or more records in a table

UPDATE Customers_db
SET ContactName='Rohan'
WHERE CustomerID = 1007;


-- Updating multiple columns
UPDATE Customers_db
SET  City = 'Delhi',
Salary = 125466
WHERE CustomerID = 1001; 


-- DELETE Statement
-- The DELETE statement is used to delete existing records in a table.

